{
  "crons": [
    {
      "path": "/api/reminders/process",
      "schedule": "0 8 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/webhooks/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "functions": {
    "api/webhooks/asaas.ts": {
      "memory": 256,
      "maxDuration": 30
    }
  }
}
